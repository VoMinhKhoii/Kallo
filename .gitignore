# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

#docs
PRD.md

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/.planning
supabase/.temp/
__pycache__/

# Claude Code: share team-wide config (.claude/agents, .claude/commands)
# but not per-session runtime state.
.claude/scheduled_tasks.lock
.claude/scheduled_tasks/
.claude/_runtime/

# USDA download output (large CSV, regenerate with scripts/usda/)
data/usda_sr/

# Translation pipeline checkpoints (generated, resume-safe)
data/translation-checkpoints/
seed_food.sql

# Local NIN ingestion snapshots and bulky generated artifacts
scripts/enrich/input/
scripts/enrich/out/*
!scripts/enrich/out/dups.csv
!scripts/enrich/out/manifest.json

# Local git worktrees
.worktrees/
.gstack/

# Local Claude Code MCP server config (no secrets, but per-developer)
.mcp.json

# Playwright MCP session artifacts
.playwright-mcp/

# Eval run artifacts — generated per run, not reviewable source. Kept on disk
# for local comparison, out of the repo so PRs stay readable.
scripts/eval/reports/

# Live pipeline captures. Megabytes of raw model output, non-deterministic, and
# not something a reviewer can read a diff of — `landing-v2.json` alone is
# ~1.1 MB across 29 cases. One was committed by accident and backed out in
# aaa5a760; this stops the next time. The analysis that makes a capture worth
# keeping goes on ttr instead (see DEV-105 for the landing set).
#
# Anchored to this directory, so the hand-authored fixtures under
# scripts/eval/fixtures/ stay tracked — they are source, these are output.
scripts/eval/*.json
