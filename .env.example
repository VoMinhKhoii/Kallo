# ----------------------------------------------------------------------------
# Required secrets and connection strings (no defaults)
# ----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Google OAuth — only needed when running local Supabase (supabase/config.toml
# substitutes these into [auth.external.google]). Cloud Supabase reads its
# Google credentials from the dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Drizzle / postgres-js. Use the transaction-mode pooler (port 6543).
DATABASE_URL=

GEMINI_API_KEY=
USDA_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# AI provider selector. "ai-studio" (default) uses GEMINI_API_KEY above.
# "vertex" uses Vertex AI via Application Default Credentials; set the two
# GOOGLE_CLOUD_* vars below. Deployed envs (nham-internal, nham-staging) set
# AI_PROVIDER=vertex in their Cloud Run workflows. Scripts in scripts/ stay
# on ai-studio regardless of this setting.
# AI_PROVIDER=ai-studio
# GOOGLE_CLOUD_PROJECT=cal-487315
# GOOGLE_CLOUD_LOCATION=global

# Server-only HMAC pepper for analysis guard event hashes. Required at runtime
# in non-test envs; the route fails closed if unset (see
# lib/rate-limit/analysis-guards.ts:204-210). Rotate on suspected exposure.
ANALYSIS_GUARD_HASH_SECRET=

# Billing environment isolation. Required by every server process. Use
# "sandbox" for local/preview/staging and "production" only for production.
BILLING_ENVIRONMENT=sandbox

# Billing stays dark by default. When enabling enforcement, a valid ISO launch
# date is mandatory; the server fails closed if enforcement is true without it.
BILLING_ENFORCEMENT_ENABLED=false
BILLING_PURCHASES_ENABLED=false
# Production-only UUID allowlist for the dedicated App Review account. These
# users project SANDBOX grants so Apple's sandbox purchase can unlock safely.
BILLING_SANDBOX_USER_IDS=
SUBSCRIPTION_LAUNCH_DATE=
TRIAL_DAYS=7

# RevenueCat server-side CustomerInfo lookup (app-specific public v1 key), runtime Web
# Billing public key, and webhook authentication. The HMAC secret is generated
# and shown once when signing is enabled in RevenueCat; until then deployments
# use the static Authorization secret.
REVENUECAT_REST_API_KEY=
REVENUECAT_WEB_API_KEY=
# Server-only RevenueCat API v2 key. Grant only
# customer_information:customers:read_write; used for account erasure.
REVENUECAT_CUSTOMER_DELETE_API_KEY=
REVENUECAT_PROJECT_ID=
# Client-public mobile SDK keys. For local Test Store testing, put the
# `test_...` key in the platform slot used by the simulator/device.
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_HMAC_SECRET=
# Enable only after each webhook integration is filtered to its matching
# sandbox/production environment. RevenueCat may omit environment on transfer
# and redemption events; trusted deployments then infer their own boundary.
REVENUECAT_INFER_MISSING_EVENT_ENVIRONMENT=false
# Defense in depth: Keep original App User ID is the supported restore policy.
REVENUECAT_ALLOW_OWNERSHIP_TRANSFER=false
# Comma-separated RevenueCat dashboard app IDs (Test Store, Apple, Google,
# Web). Required for every grant-mutating webhook.
REVENUECAT_ALLOWED_APP_IDS=

# Scheduled webhook-envelope retention. Pending events are never pruned.
BILLING_PROCESSED_RETENTION_DAYS=30
BILLING_DEAD_LETTER_RETENTION_DAYS=90

# Comma-separated allowlist for the admin pipeline dashboard.
ADMIN_EMAILS=

# ----------------------------------------------------------------------------
# Email (Resend) — every outbound email in the app
# ----------------------------------------------------------------------------
# Auth email (signup confirmation, password recovery, email change) no longer
# comes from Supabase's built-in mailer: [auth.hook.send_email] in
# supabase/config.toml posts to app/api/auth/send-email, which renders the
# message (lib/email/templates/) and sends it through Resend. The waitlist
# emails use the same seam.
#
# Server-only Resend API key. LEAVE UNSET LOCALLY unless you are testing real
# delivery: lib/email/send.ts turns into a logged no-op without it, so sign-up
# and the waitlist still work end-to-end offline.
RESEND_API_KEY=
# Standard Webhooks secret proving a hook POST really came from Supabase.
# Generate it in Supabase Dashboard → Authentication → Hooks; format is
# "v1,whsec_<base64>". Required in every environment where the hook is enabled.
SEND_EMAIL_HOOK_SECRET=
# Sender identity. Defaults (lib/email/config.ts) are the values below, so
# these only need setting to override. The sending domain is a SUBdomain on
# purpose — the apex SPF record belongs to Cloudflare Email Routing for inbound
# support@kallo.fit, and a second include on it would break both (see
# docs/PROD_DOMAIN_SETUP.md §7).
# EMAIL_FROM=Kallo <notifications@mail.kallo.fit>
# EMAIL_REPLY_TO=support@kallo.fit

# Canonical public origin (metadataBase / sitemap.xml / robots.txt) is a build-
# time constant in lib/site.ts, not an env var — a single image serves prod and
# non-prod and those routes are statically rendered, so there is nothing to set.

# Cloudflare origin-lock shared secret (prod only). When set, middleware.ts
# rejects any request whose X-Origin-Verify header does not match — the app
# refuses traffic that did not come through Cloudflare. Injected on kallo-prod
# from Secret Manager (kallo-prod-origin-shared-secret); leave unset locally.
# ORIGIN_SHARED_SECRET=

# ----------------------------------------------------------------------------
# Offline service worker — OFF by default
# ----------------------------------------------------------------------------

# Registers public/sw.js (tier-1 offline: precaches the offline page + icons,
# network-first navigations falling back to /offline.html). Unset/anything but
# "true" keeps the SW unregistered AND tears down any previously-installed SW —
# so production can never white-screen from a stale-chunk bug. Flip to "true"
# only after verifying the SW on a preview build. See
# components/app/service-worker-register.tsx.
# NEXT_PUBLIC_ENABLE_SW=true

# ----------------------------------------------------------------------------
# Pipeline per-stage timeouts and concurrency (lib/ai/pipeline/orchestrator.ts)
# All optional. Defaults are derived from observed p95s; tighten only after
# measuring with scripts/benchmark-ai-pipeline-latency.ts.
# ----------------------------------------------------------------------------

# Per-attempt LLM timeout for the decomposition stage. Default 20000 (≈p95 ×
# 1.9 from Phase B baseline). Aborts the in-flight Gemini request and lets
# withRetry move to the next attempt; full request budget is roughly
# (timeout × 3) + backoff. Override only when both stage-specific envs are
# absent — see PIPELINE_DECOMPOSITION_TIMEOUT_MS below.
# LLM_TIMEOUT_MS=

# Stage-specific override for the decomposition LLM call. Default 20000.
# PIPELINE_DECOMPOSITION_TIMEOUT_MS=20000

# Stage-specific override for the nutrition LLM call. Default 30000 (≈p95 ×
# 1.25). Nutrition has a wider p95 because it returns a per-meal-item batch.
# PIPELINE_NUTRITION_TIMEOUT_MS=30000

# Concurrency for the matching cascade Phase 1 (embedding resolve) and
# Phase 2 (per-ingredient vector match) loops. Default 4. Bumping higher
# collapses sequential rounds but is bounded by the pgvector pool size.
# PIPELINE_MATCH_CONCURRENCY=4

# ----------------------------------------------------------------------------
# Pipeline canary flags — all default OFF in production
#
# Do not set any of these in deployed environments without first filling the
# corresponding row in
# docs/superpowers/plans/2026-05-03-ai-pipeline-prompt-budget-global-redesign-rollout-thresholds.md
# and capturing measured numbers via
# docs/superpowers/plans/2026-05-08-ai-pipeline-latency-regression.md.
# ----------------------------------------------------------------------------

# Model profile. Default: stable (gemini-2.5-flash-lite for both Call 1 and
# Call 2; no escalation). Set to "next" only after benchmarking the preview
# flash-lite path. See lib/ai/pipeline/model-profile.ts.
# PIPELINE_MODEL_PROFILE=stable

# Provider JSON-schema mode. Default: full (descriptions kept). "slim" strips
# descriptions and runtime-owned ID fields. Canary — token saving is unproven
# and may regress structured-output reliability on flash-lite. See
# lib/ai/prompts/schema.ts.
# PIPELINE_PROVIDER_SCHEMA_MODE=

# Decomposition prompt label. Default: production. "compressed" drops example
# blocks and detailed instructions. Canary — see
# lib/ai/prompts/decomposition.ts.
# PIPELINE_DECOMPOSITION_PROMPT_LABEL=

# Nutrition prompt label. Default: compressed (flipped 2026-05-09 — see
# Phase B measurement in lib/ai/prompts/nutrition.ts:getNutritionPromptLabel).
# Set to "production" to revert to the older verbose prompt. Canary — see
# lib/ai/prompts/nutrition.ts.
# PIPELINE_NUTRITION_PROMPT_LABEL=production

# Persist pipeline_requests / pipeline_stage_logs / pipeline_llm_calls rows.
# Default: off. The orchestrator already records always-on telemetry through
# pipeline_runs and analysis_model_budget_events; this flag enables the deeper
# admin trace tables. See lib/ai/pipeline/trace.ts:12.
# PIPELINE_TRACE_ENABLED=true

# ----------------------------------------------------------------------------
# Pipeline subcomponent kill-switches — all default ON
#
# Set any of these to "false" / "0" / "off" to disable the subcomponent at
# runtime without redeploying. Useful for incident triage, A/B latency
# probes, and the harness in scripts/benchmark-ai-pipeline-latency.ts.
# Implementation: readBooleanEnv() in lib/ai/pipeline/feature-flags.ts.
# ----------------------------------------------------------------------------

# L4 in-process decomposition cache (lib/ai/pipeline/orchestrator.ts:545).
# Default ON outside tests. Disable to force every request to call the
# decomposition LLM, e.g. when investigating a stale-cache complaint.
# PIPELINE_L4_DECOMPOSITION_CACHE_ENABLED=true

# L1 in-memory + L2 Postgres embedding cache (lib/ai/matching/embedding-cache.ts).
# Disable to bypass both tiers (forces a Gemini embedding call for every
# ingredient name) — useful for measuring the cache's actual win, but expect
# a large latency regression in real traffic.
# PIPELINE_EMBEDDING_CACHE_ENABLED=true

# 526-row VN FCT warm-up scan triggered on first L1 miss
# (lib/ai/matching/embedding-cache.ts:50). Disable when running offline or
# pointed at a DB that doesn't have the food composition table populated.
# PIPELINE_EMBEDDING_CACHE_WARMUP_ENABLED=true

# Speculative embedding pre-warming during the decomposition stream
# (lib/ai/matching/speculative.ts). Disable to remove the streaming-side
# Gemini embedding call; matching falls back to its synchronous batch.
# PIPELINE_SPECULATIVE_PREWARM_ENABLED=true

# Pre-match alias rewrites (lib/ai/matching/cascade.ts:82). Disable when a
# new alias entry causes regressions; the cascade falls back to the
# canonical name as-is.
# PIPELINE_PREMATCH_ALIAS_ENABLED=true

# Phase 3b alias fallback for unmatched ingredients
# (lib/ai/matching/cascade.ts:215). Disable to skip the extra Gemini batch
# + DB lookup; unmatched ingredients surface immediately.
# PIPELINE_ALIAS_FALLBACK_ENABLED=true

# Call 1 retry when the decomposition output is in the wrong language
# (lib/ai/pipeline/orchestrator.ts:629). Disable to keep the first attempt
# regardless of language guard verdict — saves one LLM call per misfire,
# at the cost of mixed-language responses for some inputs.
# PIPELINE_LANGUAGE_GUARD_RETRY_ENABLED=true

# Buffer item_name SSE events until the language guard passes
# (lib/ai/pipeline/orchestrator.ts:506). Disable to stream item_name
# events as soon as they parse — improves perceived latency, but on a
# language-mismatch retry the client briefly sees both languages.
# PIPELINE_ITEM_NAME_BUFFER_ENABLED=true

# ----------------------------------------------------------------------------
# Shadow runner — off by default
# ----------------------------------------------------------------------------

# SHADOW_RUNNER_ENABLED=true
# SHADOW_CANDIDATE_PROMPT_LABEL=production
# SHADOW_CANDIDATE_MODEL=

# ----------------------------------------------------------------------------
# Analysis route subcomponent kill-switches — all default ON
# ----------------------------------------------------------------------------

# Always-on model token budget event writes from the orchestrator
# (lib/ai/pipeline/orchestrator.ts:264). Disable to silence 3 events/request
# when chasing pool contention or DB cost spikes; rate-limit decisions still
# work since they consult the same table only on writes that did happen.
# ANALYSIS_BUDGET_EVENTS_ENABLED=true

# Insert into analysis_guard_events when a request is blocked
# (app/api/analyze-meal/route.ts:159). Disable to stop logging guard hits
# (e.g., during a noisy abuse incident); the 429 response still goes back.
# ANALYSIS_GUARD_EVENT_LOGGING_ENABLED=true

# ----------------------------------------------------------------------------
# Analysis abuse guards (lib/rate-limit/analysis-guards.ts)
# Defaults are conservative; uncomment only to override. All limits fail OPEN
# only at the secret check; everything else fails CLOSED with retry-after.
# ----------------------------------------------------------------------------

# Per-user meal-analysis route quotas.
# ANALYSIS_USER_MINUTE_LIMIT=3
# ANALYSIS_USER_HOUR_LIMIT=30
# ANALYSIS_USER_DAY_LIMIT=100
# ANALYSIS_USER_CONCURRENT_LIMIT=1
# ANALYSIS_CONCURRENT_RETRY_AFTER_SECONDS=15
# ANALYSIS_IN_FLIGHT_STALE_AFTER_SECONDS=90

# Admin replay quota (separate bucket from user quotas).
# ANALYSIS_ADMIN_REPLAY_HOUR_LIMIT=5

# Nonessential-work guards — shadow runs and global model budget.
# ANALYSIS_SHADOW_DAILY_REQUEST_LIMIT=100
# ANALYSIS_GLOBAL_DAILY_REQUEST_LIMIT=5000
# ANALYSIS_GLOBAL_DAILY_TOKEN_LIMIT=5000000
# ANALYSIS_PROVIDER_ERROR_WINDOW_SECONDS=300
# ANALYSIS_PROVIDER_ERROR_THRESHOLD=5
# ANALYSIS_PROVIDER_PRESSURE_RETRY_AFTER_SECONDS=60

# Provider pressure manual override. auto = derive from recent error window;
# on/true/force_on = force pressure on; off/false/force_off = force off.
# ANALYSIS_PROVIDER_PRESSURE_OVERRIDE=auto
