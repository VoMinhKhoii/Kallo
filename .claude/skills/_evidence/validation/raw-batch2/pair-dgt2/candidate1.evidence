diff --git a/lib/actions/weight.ts b/lib/actions/weight.ts
index f00244a..d3cfa6b 100644
--- a/lib/actions/weight.ts
+++ b/lib/actions/weight.ts
@@ -46,6 +46,28 @@ function toNumber(value: string | number | null | undefined): number | null {
   return Number.isFinite(parsed) ? parsed : null;
 }
 
+function computeWeeklyChange(
+  rows: { loggedDate: string; weightKg: string | null }[]
+): number | null {
+  if (rows.length < 2) return null;
+  const latest = rows[rows.length - 1];
+  const latestWeight = toNumber(latest.weightKg);
+  if (latestWeight === null) return null;
+
+  // rows are sorted ascending by loggedDate, so the last entry on or before the
+  // week-ago boundary is the closest one from "about a week" back.
+  const referenceDate = shiftDate(latest.loggedDate, -7);
+  let priorWeight: number | null = null;
+  for (const row of rows) {
+    if (row.loggedDate > referenceDate) break;
+    const weight = toNumber(row.weightKg);
+    if (weight !== null) priorWeight = weight;
+  }
+  if (priorWeight === null) return null;
+
+  return latestWeight - priorWeight;
+}
+
 function getWeeklyRate(goal: string | null): number {
   if (goal === 'bulking') return 0.25;
   if (goal === 'cutting') return -0.4;
@@ -231,5 +253,6 @@ export async function loadWeightSummaryAction(input: {
     periodElapsedDays,
     projectedEndWeight,
     canProject,
+    weeklyChange: computeWeeklyChange(rows),
   };
 }
