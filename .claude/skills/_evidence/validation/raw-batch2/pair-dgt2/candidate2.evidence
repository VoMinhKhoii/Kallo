@@ -193,6 +193,23 @@ export async function loadWeightSummaryAction(input: {
   const periodStartWeight = weights[0] ?? currentWeight;
   const firstRangeRow = rows[0];
   const lastRangeRow = rows[rows.length - 1];
+
+  // Weekly change: most recent logged weight minus the nearest logged weight at
+  // or before 7 days ago. Rows are ascending by date, so the last row on/before
+  // the week-ago cutoff is the reference. `null` when there's nothing that far
+  // back to compare against.
+  const weekAgoDate = shiftDate(todayDate, -7);
+  const referenceRow = rows.reduce<(typeof rows)[number] | null>(
+    (nearest, row) => (row.loggedDate <= weekAgoDate ? row : nearest),
+    null
+  );
+  const referenceWeight = toNumber(referenceRow?.weightKg);
+  const latestSeriesWeight = toNumber(lastRangeRow?.weightKg);
+  const weeklyChange =
+    referenceWeight !== null && latestSeriesWeight !== null
+      ? latestSeriesWeight - referenceWeight
+      : null;
+
   const periodElapsedDays =
     firstRangeRow && lastRangeRow
       ? daysBetween(firstRangeRow.loggedDate, lastRangeRow.loggedDate)
@@ -229,6 +246,7 @@ export async function loadWeightSummaryAction(input: {
