diff --git a/lib/actions/__tests__/weight.test.ts b/lib/actions/__tests__/weight.test.ts
index 14907b8..f2a9189 100644
--- a/lib/actions/__tests__/weight.test.ts
+++ b/lib/actions/__tests__/weight.test.ts
@@ -240,6 +240,51 @@ describe('loadWeightSummaryAction', () => {
     expect(result.periodStartWeight).toBe(72.4);
     expect(result.periodElapsedDays).toBe(2);
     expect(result.expectedEndWeight).toBeLessThan(result.periodStartWeight);
+    // No log at/before 7 days ago, so there's nothing to compare against.
+    expect(result.weeklyChange).toBeNull();
+  });
+
+  it('computes weeklyChange from the nearest log at/before 7 days ago', async () => {
+    const today = new Date().toISOString().slice(0, 10);
+    const shift = (days: number) => {
+      const d = new Date(`${today}T00:00:00.000Z`);
+      d.setUTCDate(d.getUTCDate() - days);
+      return d.toISOString().slice(0, 10);
+    };
+
+    // Reference is the log 8 days ago (nearest at/before the 7-day cutoff),
+    // not the 6-days-ago log; current is today.
+    const rangeRows = [
+      { loggedDate: shift(8), weightKg: '73.0' },
+      { loggedDate: shift(6), weightKg: '72.5' },
+      { loggedDate: today, weightKg: '71.8' },
+    ];
+    const latestRows = [{ loggedDate: today, weightKg: '71.8' }];
+
+    mockDbSelect
+      .mockReturnValueOnce({
+        from: vi.fn().mockReturnValue({
+          where: vi.fn().mockReturnValue({
+            orderBy: vi.fn().mockResolvedValue(rangeRows),
+          }),
+        }),
+      })
+      .mockReturnValueOnce({
+        from: vi.fn().mockReturnValue({
+          where: vi.fn().mockReturnValue({
+            orderBy: vi.fn().mockReturnValue({
+              limit: vi.fn().mockResolvedValue(latestRows),
+            }),
+          }),
+        }),
+      });
+
+    const result = await loadWeightSummaryAction({
+      range: '30d',
+      timezoneOffset: 0,
+    });
+
+    expect(result.weeklyChange).toBeCloseTo(71.8 - 73.0, 5);
   });
 
   it('marks goal direction as flat for maintenance goals', async () => {
