=== NEW FILES ===
--- supabase/migrations/20260705120000_add_barcode_serving_overrides.sql ---
-- Per-user serving-size overrides for scanned barcode products.
--
-- The product cache (vietnamese_food_composition, id `off_<barcode>`) is global
-- and shared, so it cannot store a personal serving. This table remembers each
-- user's own serving definition for a product — e.g. "one serving of this
-- cookie is 2 pieces = 22g" — which the barcode amount picker uses in place of
-- (or in the absence of) the Open Food Facts serving size.
--
-- Additive and idempotent; safe to re-run. Dropping this table fully reverts
-- the feature without touching any existing data.

CREATE TABLE IF NOT EXISTS "barcode_serving_overrides" (
	"user_id" uuid NOT NULL,
	"food_composition_id" text NOT NULL,
	"serving_size_g" numeric NOT NULL,
	"serving_label" text,
	"updated_at" timestamp with time zone DEFAULT now() NOT NULL,
	CONSTRAINT "barcode_serving_overrides_pkey" PRIMARY KEY ("user_id", "food_composition_id"),
	CONSTRAINT "barcode_serving_overrides_size_positive" CHECK ("serving_size_g" > 0)
);

DO $$ BEGIN
	ALTER TABLE "barcode_serving_overrides"
		ADD CONSTRAINT "barcode_serving_overrides_user_id_users_id_fk"
		FOREIGN KEY ("user_id") REFERENCES "auth"."users"("id") ON DELETE cascade ON UPDATE no action;
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

DO $$ BEGIN
	ALTER TABLE "barcode_serving_overrides"
		ADD CONSTRAINT "barcode_serving_overrides_food_composition_id_fk"
		FOREIGN KEY ("food_composition_id") REFERENCES "public"."vietnamese_food_composition"("id") ON DELETE cascade ON UPDATE no action;
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

-- RLS: an override is strictly private to its owner. Every operation is scoped
-- to the calling user (the Drizzle path additionally filters by user_id; these
-- policies protect the PostgREST/anon-key path).
ALTER TABLE "barcode_serving_overrides" ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "Owner can view own serving overrides" ON "barcode_serving_overrides";
CREATE POLICY "Owner can view own serving overrides"
	ON "barcode_serving_overrides" FOR SELECT
	TO authenticated
	USING (user_id = auth.uid());

DROP POLICY IF EXISTS "Owner can insert own serving overrides" ON "barcode_serving_overrides";
CREATE POLICY "Owner can insert own serving overrides"
	ON "barcode_serving_overrides" FOR INSERT
	TO authenticated
	WITH CHECK (user_id = auth.uid());

DROP POLICY IF EXISTS "Owner can update own serving overrides" ON "barcode_serving_overrides";
CREATE POLICY "Owner can update own serving overrides"
	ON "barcode_serving_overrides" FOR UPDATE
	TO authenticated
	USING (user_id = auth.uid())
	WITH CHECK (user_id = auth.uid());

DROP POLICY IF EXISTS "Owner can delete own serving overrides" ON "barcode_serving_overrides";
