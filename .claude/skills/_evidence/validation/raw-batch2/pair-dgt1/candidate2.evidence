=== NEW FILES ===
--- supabase/migrations/20260705120000_add_product_serving_overrides.sql ---
-- Per-user, per-product serving-size overrides for scanned barcode products.
--
-- The Open Food Facts serving size stored on vietnamese_food_composition is a
-- single shared value across all users. This table lets each user remember
-- their own serving definition for a specific product — e.g. "for this cookie,
-- one serving is 2 pieces = 22g" — without mutating the shared row.
--
-- Composite PK (user_id, food_composition_id): at most one override per user
-- per product. Both FKs cascade on delete so overrides disappear when the user
-- account or the cached product row is removed. Additive; safe to re-run.

CREATE TABLE IF NOT EXISTS public.product_serving_overrides (
  user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  food_composition_id text NOT NULL
    REFERENCES public.vietnamese_food_composition(id) ON DELETE CASCADE,
  serving_size_g numeric NOT NULL,
  label text,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY (user_id, food_composition_id)
);

-- Keep updated_at fresh on upsert-driven updates (reuses the shared trigger fn
-- defined in 20260228155945_rls_new_tables.sql).
DROP TRIGGER IF EXISTS on_product_serving_overrides_updated
  ON public.product_serving_overrides;
CREATE TRIGGER on_product_serving_overrides_updated
  BEFORE UPDATE ON public.product_serving_overrides
  FOR EACH ROW
  EXECUTE FUNCTION public.handle_updated_at();

-- RLS: direct user_id ownership (mirrors body_weight_log).
ALTER TABLE public.product_serving_overrides ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Users can view own serving overrides"
  ON public.product_serving_overrides FOR SELECT
  USING (auth.uid() = user_id);

CREATE POLICY "Users can insert own serving overrides"
  ON public.product_serving_overrides FOR INSERT
  WITH CHECK (auth.uid() = user_id);

CREATE POLICY "Users can update own serving overrides"
  ON public.product_serving_overrides FOR UPDATE
  USING (auth.uid() = user_id);

CREATE POLICY "Users can delete own serving overrides"
  ON public.product_serving_overrides FOR DELETE
  USING (auth.uid() = user_id);
