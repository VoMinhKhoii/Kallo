+  unit: ProductUnit;
 }
 
 function parseNumber(val: unknown): number | null {
@@ -79,6 +90,38 @@ export function parseSizeGrams(val: unknown): number | null {
   return num;
 }
 
+const VOLUME_UNITS = new Set(['ml', 'cl', 'dl', 'l']);
+
+/** Decide whether a product is measured by volume (ml) or weight (g). Prefers
+ *  OFF's explicit unit fields, then the beverages category, then a free-text
+ *  net-quantity like "330 ml". Defaults to grams — the common case. */
+function resolveUnit(
+  product: z.infer<typeof openFoodFactsProductSchema>
+): ProductUnit {
+  const explicit = (
+    product.product_quantity_unit ??
+    product.serving_quantity_unit ??
+    ''
+  )
+    .trim()
+    .toLowerCase();
+  if (VOLUME_UNITS.has(explicit)) return 'ml';
+  if (explicit === 'g' || explicit === 'kg' || explicit === 'mg') return 'g';
+
+  if (product.categories_tags?.some((tag) => tag.includes('beverages'))) {
+    return 'ml';
+  }
+
+  if (
+    typeof product.quantity === 'string' &&
+    /\d\s*(?:ml|cl|dl|l)\b/i.test(product.quantity)
+  ) {
+    return 'ml';
+  }
+
+  return 'g';
+}
