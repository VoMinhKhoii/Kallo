diff --git a/lib/barcode/constants.ts b/lib/barcode/constants.ts
index b51c346..0b4dd8d 100644
--- a/lib/barcode/constants.ts
+++ b/lib/barcode/constants.ts
@@ -6,3 +6,21 @@
  *  dependency-light module so the client picker can import it without pulling
  *  in server-side fetch code. */
 export const MAX_FOOD_ITEM_GRAMS = 100_000;
+
+/** Measurement unit for a packaged product's amount. Beverages are sold and
+ *  logged by volume (ml); everything else by weight (g). Macros are always in
+ *  grams regardless. */
+export type ProductUnit = 'g' | 'ml';
+
+/** Cached type labels for the food-composition row. The unit is not stored in a
+ *  dedicated column — it's recovered on cache read from `typeEn` — so these
+ *  strings are the single source of truth for both write and read. */
+export const PACKAGED_TYPE_VN = 'Sản phẩm đóng gói';
+export const PACKAGED_TYPE_EN = 'Packaged product';
+export const BEVERAGE_TYPE_VN = 'Đồ uống đóng gói';
+export const BEVERAGE_TYPE_EN = 'Packaged beverage';
+
+/** Recover the amount unit from a cached row's English type label. */
+export function unitFromTypeEn(typeEn: string): ProductUnit {
+  return typeEn === BEVERAGE_TYPE_EN ? 'ml' : 'g';
+}
