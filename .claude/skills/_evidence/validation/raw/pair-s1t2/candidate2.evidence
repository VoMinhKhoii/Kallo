#!/usr/bin/env node
/**
 * Migration Date Validator
 *
 * Scans supabase/migrations/*.sql, prints how many migrations exist and the
 * newest filename, and fails (exit 1) if any migration's 14-digit timestamp
 * prefix (YYYYMMDDHHMMSS) is dated in the future.
 *
 * Timestamps are interpreted as UTC, matching the Supabase CLI, which stamps
 * `supabase migration new` filenames in UTC.
 *
 * Exit codes:
 *   0 - All migrations are dated now or in the past
 *   1 - One or more migrations are future-dated (or the directory is missing)
 */

import fs from 'node:fs';
import path from 'node:path';

const MIGRATIONS_DIR = 'supabase/migrations';

/**
 * Parse a 14-digit YYYYMMDDHHMMSS string as a UTC instant.
 * Returns null if the digits do not form a real calendar date/time.
 */
function parseTimestamp(ts) {
  if (!/^\d{14}$/.test(ts)) return null;
  const year = Number(ts.slice(0, 4));
  const month = Number(ts.slice(4, 6)) - 1;
  const day = Number(ts.slice(6, 8));
  const hour = Number(ts.slice(8, 10));
  const min = Number(ts.slice(10, 12));
  const sec = Number(ts.slice(12, 14));
  const d = new Date(Date.UTC(year, month, day, hour, min, sec));
  // Date.UTC silently normalizes impossible dates (e.g. 20250231 → Mar 3),
  // so round-trip the components and reject anything that didn't survive.
  if (
    d.getUTCFullYear() !== year ||
    d.getUTCMonth() !== month ||
    d.getUTCDate() !== day ||
    d.getUTCHours() !== hour ||
    d.getUTCMinutes() !== min ||
    d.getUTCSeconds() !== sec
  ) {
    return null;
  }
  return d;
}

function fmtUtc(date) {
  return date.toISOString().replace('T', ' ').replace(/\.\d{3}Z$/, ' UTC');
}

function main() {
  const dir = path.join(process.cwd(), MIGRATIONS_DIR);

  if (!fs.existsSync(dir)) {
    console.error(`ERROR: Migration directory not found: ${MIGRATIONS_DIR}`);
    process.exit(1);
  }

  const files = fs
    .readdirSync(dir)
    .filter((f) => f.endsWith('.sql'))
    .sort();

  console.log(`Found ${files.length} migration(s) in ${MIGRATIONS_DIR}.`);

  if (files.length === 0) {
    process.exit(0);
  }

  console.log(`Newest migration: ${files[files.length - 1]}`);

  const now = new Date();
  console.log(`Current time:     ${fmtUtc(now)}\n`);

  const future = [];

  for (const filename of files) {
    const m = filename.match(/^(\d{14})_/);
    if (!m) continue; // not our concern here — only date validation
    const date = parseTimestamp(m[1]);
    if (!date) continue;
    if (date.getTime() > now.getTime()) {
      future.push({ filename, ts: m[1], date });
    }
  }

  if (future.length > 0) {
    console.error(
      `FAILED: ${future.length} migration(s) are future-dated (timestamps are UTC):`
    );
    for (const { filename, date } of future) {
      console.error(`  - ${filename} → ${fmtUtc(date)} (after ${fmtUtc(now)})`);
    }
    process.exit(1);
  }

  console.log('OK: no future-dated migrations.');
}

main();
