--- a/lib/utils.ts
+++ b/lib/utils.ts
@@ -21,13 +21,22 @@ export function capitalizeFirst(s: string): string {
  */
 export function parseDecimalInput(value: string | number): number {
   if (typeof value === 'number') return value;
-  let normalized = value.trim();
-  // EU inputs like "1.234,5" use '.' for thousands and ',' for decimals.
-  if (normalized.includes('.') && normalized.includes(',')) {
-    normalized = normalized.replace('.', '');
+  const trimmed = value.trim();
+  if (trimmed === '') return Number.NaN;
+
+  // Both ',' and '.' are used as decimal separators (EU vs US keyboards) and
+  // as thousands separators. Treat the *last* separator as the decimal point
+  // and strip every other separator as a thousands grouping. This handles
+  // "1,234.5" (US), "1.234,5" (EU), and "65,3"/"65.3" (single-separator) alike.
+  const lastSep = Math.max(trimmed.lastIndexOf(','), trimmed.lastIndexOf('.'));
+  let normalized: string;
+  if (lastSep === -1) {
+    normalized = trimmed;
+  } else {
+    const intPart = trimmed.slice(0, lastSep).replace(/[.,]/g, '');
+    const fracPart = trimmed.slice(lastSep + 1);
+    normalized = `${intPart}.${fracPart}`;
   }
-  normalized = normalized.replace(',', '.');
-  if (normalized === '') return Number.NaN;
   return Number(normalized);
 }
 
