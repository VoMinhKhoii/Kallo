--- a/lib/utils.ts
+++ b/lib/utils.ts
@@ -22,12 +22,26 @@ export function capitalizeFirst(s: string): string {
 export function parseDecimalInput(value: string | number): number {
   if (typeof value === 'number') return value;
   let normalized = value.trim();
-  // EU inputs like "1.234,5" use '.' for thousands and ',' for decimals.
-  if (normalized.includes('.') && normalized.includes(',')) {
-    normalized = normalized.replace('.', '');
-  }
-  normalized = normalized.replace(',', '.');
   if (normalized === '') return Number.NaN;
+
+  const lastComma = normalized.lastIndexOf(',');
+  const lastDot = normalized.lastIndexOf('.');
+
+  if (lastComma !== -1 && lastDot !== -1) {
+    // Both separators present (e.g. US "1,234.5" or EU "1.234,5"). The
+    // right-most separator is the decimal point; the other groups thousands
+    // and must be stripped.
+    const decimalSep = lastComma > lastDot ? ',' : '.';
+    const thousandsSep = decimalSep === ',' ? '.' : ',';
+    normalized = normalized
+      .split(thousandsSep)
+      .join('')
+      .replace(decimalSep, '.');
+  } else {
+    // Only one separator kind: treat a lone comma as the decimal point, which
+    // is what iOS/EU keyboards emit (e.g. "65,3").
+    normalized = normalized.replace(',', '.');
+  }
   return Number(normalized);
 }
 
