{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/dev/link-worktree-env.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/flutter-setup.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-path.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:/opt/homebrew/bin:/usr/local/bin\" node \"$CLAUDE_PROJECT_DIR/scripts/dev/push-gates/push-gates.mjs\"",
            "timeout": 600,
            "statusMessage": "Running CI gates before push"
          }
        ]
      }
    ]
  }
}
