<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31): the system draws the launch splash itself from
         these attributes and ignores windowBackground's bitmap, falling back to
         the launcher icon. Name the ink K and the app canvas explicitly so the
         splash matches iOS and the Flutter launch intro's first frame.
         Dark Mode off; the app has one light look, so both modes match. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
