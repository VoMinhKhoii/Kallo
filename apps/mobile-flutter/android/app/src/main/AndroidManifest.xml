<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Declared here, not left to a plugin's manifest merge: every network
         call (Supabase, the API, PostHog, Sentry) depends on it in release. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The camera plugin merges RECORD_AUDIO in, but the scan camera opens
         with enableAudio: false. Removed so Play does not list microphone
         access the app never uses. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <application
        android:label="Kallo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase OAuth/magic-link deep link: nham://auth-callback.
                 supabase_flutter's deep-link observer completes the PKCE
                 exchange on return; only the native registration is needed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="nham" android:host="auth-callback"/>
            </intent-filter>
            <!-- Circle invite deep link: nham://invite/<slug>. Captured by the
                 app_links listener (CircleDeepLinkListener) and routed to the
                 in-app connect screen. iOS accepts any host on the registered
                 `nham` scheme, so no Info.plist change is needed there.
                 TODO(P2): add an autoVerify https App Link + assetlinks.json so
                 shareable https invite links open the app too (infra handoff). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="nham" android:host="invite"/>
            </intent-filter>
            <!-- Home-screen widget tap: nham://today (TodayWidgetProvider.LINK).
                 TodayWidgetLink routes it to Today, as on iOS. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="nham" android:host="today"/>
            </intent-filter>
        </activity>
        <!-- The home-screen "Today" widget (apps/docs/mobile/today-widget.md).
             The app writes the day through home_widget, which broadcasts
             APPWIDGET_UPDATE to this class by name. The other actions are the
             provider's own midnight / theme alarm and clock changes, which
             all redraw the date and theme with the app closed. -->
        <receiver
            android:name=".todaywidget.TodayWidgetProvider"
            android:label="@string/today_widget_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.LOCALE_CHANGED"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info"/>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- PostHog starts from Dart (Analytics.setup) and only with a key;
             never let the native SDK self-start from manifest config. -->
        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false" />
        <!-- No push capture: tokens and payloads (meal previews) stay out of
             PostHog, including a push opened on a cold start. -->
        <meta-data
            android:name="com.posthog.posthog.CAPTURE_PUSH_NOTIFICATION_OPENED"
            android:value="false" />
        <meta-data
            android:name="com.posthog.posthog.CAPTURE_PUSH_NOTIFICATION_SUBSCRIPTIONS"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
