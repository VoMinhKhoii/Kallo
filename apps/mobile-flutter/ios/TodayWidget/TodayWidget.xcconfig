// The extension's version must equal the app's or App Store Connect rejects
// the upload ("CFBundleVersion of an app extension must match its parent").
// Same reason, same include as NotificationService.xcconfig: Flutter writes
// the app's build name/number to Generated.xcconfig. Not Release.xcconfig,
// which pulls in the Runner's Pods settings — the extension links no pods.
#include "../Flutter/Generated.xcconfig"
