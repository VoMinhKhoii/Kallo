# Pin fastlane to the version the last green TestFlight run used (2.241.2, Ruby 3.3).
# Gemfile.lock pins every dependency with checksums; CI installs it frozen.
# Bump with `bundle update fastlane` (Bundler >= 2.6 keeps the CHECKSUMS).
# CI: `bundle install` then `bundle exec fastlane ios beta`.
source "https://rubygems.org"

gem "fastlane", "2.241.2"
