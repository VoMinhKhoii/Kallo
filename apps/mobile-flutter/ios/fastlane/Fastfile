default_platform(:ios)

# ---------------------------------------------------------------------------
# Nhẩm — Flutter iOS → TestFlight pipeline  (verified 2026-06-06, build 1.0.0(4))
#
# Auth: App Store Connect API key. The .p8 is NEVER committed; it lives at
#   ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# Key/Issuer/Team IDs are not secret (useless without the .p8) but can be
# overridden via env for CI.
#
# Distribution uses MANUAL signing scoped to the Runner target only — applying
# a profile globally breaks Pod/SwiftPM dependency targets ("does not support
# provisioning profiles"). The cert + App Store profile are created on demand
# from the API key into an isolated keychain.
#
# Production client config mirrors the RN app's EAS "production" profile
# (same Cloud Run backend + Supabase). All values are client-PUBLIC.
# ---------------------------------------------------------------------------

APP_ID            = ENV["ASC_APP_IDENTIFIER"] || "com.khoivo.nham"
TEAM_ID           = ENV["ASC_TEAM_ID"]        || "ZNG57U88R5"
API_BASE_URL      = ENV["NHAM_API_BASE_URL"]  || "https://nham-internal-714321235532.asia-southeast3.run.app"
SUPABASE_URL      = ENV["NHAM_SUPABASE_URL"]  || "https://oudpzhfzirgjbhrzcett.supabase.co"
SUPABASE_ANON_KEY = ENV["NHAM_SUPABASE_KEY"]  || "sb_publishable_TIrP9KQanbXTxsxJcERbLA_cI6PSNeV"

KEYCHAIN_NAME = "nham-ci.keychain-db"
KEYCHAIN_PASS = ENV["NHAM_KEYCHAIN_PASSWORD"] || "nham-ci"

def asc_api_key
  app_store_connect_api_key(
    key_id:       ENV["ASC_KEY_ID"]    || "HCTS6DXGYV",
    issuer_id:    ENV["ASC_ISSUER_ID"] || "6e626ffe-63c6-41ae-8fb7-52f62fb4788e",
    key_filepath: ENV["ASC_KEY_FILEPATH"] ||
                  File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV["ASC_KEY_ID"] || "HCTS6DXGYV"}.p8"),
    in_house: false,
  )
end

platform :ios do
  desc "Validate API key + print latest TestFlight build number"
  lane :validate do
    n = latest_testflight_build_number(api_key: asc_api_key, app_identifier: APP_ID, initial_build_number: 0)
    UI.success("Auth OK. #{APP_ID} latest TestFlight build: #{n}")
  end

  desc "Create/refresh the Apple Distribution cert + App Store profile from the API key"
  lane :signing do
    key = asc_api_key
    kc_path = File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}")
    unless File.exist?(kc_path)
      create_keychain(name: KEYCHAIN_NAME, password: KEYCHAIN_PASS, default_keychain: false,
                      unlock: true, timeout: 21600, lock_when_sleeps: false, add_to_search_list: true)
    end
    sh("security", "unlock-keychain", "-p", KEYCHAIN_PASS, kc_path)
    cert(api_key: key, keychain_path: kc_path, keychain_password: KEYCHAIN_PASS)
    get_provisioning_profile(api_key: key, app_identifier: APP_ID, fail_on_name_taken: false)
    lane_context[SharedValues::SIGH_NAME]
  end

  desc "Build the Flutter release IPA (prod config) and upload to TestFlight"
  lane :beta do
    key = asc_api_key
    next_build = latest_testflight_build_number(api_key: key, app_identifier: APP_ID, initial_build_number: 0) + 1
    UI.message("Building #{APP_ID} → build #{next_build}")

    profile_name = self.runner.execute(:signing, :ios) # cert + profile; returns profile name

    # Compile Dart with PROD defines. --no-codesign so the Flutter build phase
    # doesn't need a cert; signing happens in the xcodebuild archive below.
    #
    # fastlane runs under Homebrew Ruby and exports GEM_HOME/GEM_PATH/RUBYOPT
    # for its own gems. Those leak into the `pod` subprocess that `flutter build`
    # spawns, making CocoaPods load the wrong native gems → "CocoaPods is
    # installed but broken" and pod install is skipped. Strip the Ruby/Bundler
    # env so flutter's pod invocation uses the system CocoaPods cleanly.
    Dir.chdir("..") do # apps/mobile-flutter
      ruby_env_keys = %w[
        GEM_HOME GEM_PATH RUBYOPT RUBYLIB
        BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLER_VERSION BUNDLER_SETUP
      ]
      saved = {}
      ruby_env_keys.each { |k| saved[k] = ENV.delete(k) }
      begin
        sh("flutter", "build", "ios", "--release", "--no-codesign",
           "--build-name=1.0.1", "--build-number=#{next_build}",
           "--dart-define=API_BASE_URL=#{API_BASE_URL}",
           "--dart-define=SUPABASE_URL=#{SUPABASE_URL}",
           "--dart-define=SUPABASE_ANON_KEY=#{SUPABASE_ANON_KEY}")
      ensure
        saved.each { |k, v| ENV[k] = v unless v.nil? }
      end
    end

    # Manual signing on the Runner target ONLY (never global — breaks deps).
    update_code_signing_settings(
      use_automatic_signing: false, path: "Runner.xcodeproj",
      team_id: TEAM_ID, code_sign_identity: "Apple Distribution",
      profile_name: profile_name, bundle_identifier: APP_ID, targets: ["Runner"],
    )

    sh("security", "unlock-keychain", "-p", KEYCHAIN_PASS,
       File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}"))

    # fastlane 2.235 runs `sh` from the Fastfile's own dir (ios/fastlane), but
    # these xcodebuild paths (Runner.xcworkspace, ../build, ExportOptions.plist)
    # are written relative to ios/. Pin CWD to ios/ so they resolve.
    Dir.chdir(File.expand_path("..", __dir__)) do # ios/
      sh("xcodebuild -workspace Runner.xcworkspace -scheme Runner -configuration Release " \
         "-sdk iphoneos -destination 'generic/platform=iOS' " \
         "-archivePath ../build/Runner.xcarchive archive")

      sh("xcodebuild -exportArchive -archivePath ../build/Runner.xcarchive " \
         "-exportPath ../build/ios/ipa -exportOptionsPlist ExportOptions.plist")
    end

    upload_to_testflight(
      api_key: key, app_identifier: APP_ID,
      ipa: File.expand_path("../build/ios/ipa/nham_mobile.ipa", File.expand_path("..", __dir__)),
      skip_waiting_for_build_processing: true, skip_submission: true,
    )
  end
end
