# Copy to .env and fill from your Supabase project (the SAME project as web).
# Only EXPO_PUBLIC_* variables are exposed to the client bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the /api/v1 REST surface lives.
# Local dev: http://localhost:3000 works for the iOS simulator and web.
# A physical device must use your machine's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# --- Observability (both optional; each is a complete no-op until set) --------
# Sentry crash reporting. Leave blank to disable Sentry entirely.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: environment label (defaults to development/production via __DEV__).
EXPO_PUBLIC_ENV=
# Optional: force Sentry on + verbose logs in dev (set to 1).
EXPO_PUBLIC_SENTRY_DEBUG=
# Optional (recommended once Sentry is on): use RN fetch so Sentry network
# breadcrumbs/spans capture requests on SDK 56 (which defaults to expo/fetch).
# EXPO_PUBLIC_USE_RN_FETCH=1

# PostHog product analytics. Leave blank to disable PostHog entirely.
EXPO_PUBLIC_POSTHOG_KEY=
# PostHog host (default https://us.i.posthog.com; use the eu variant if your
# PostHog project is hosted in the EU).
EXPO_PUBLIC_POSTHOG_HOST=

# --- Build-time only (NEVER commit; set as EAS secrets) -----------------------
# Enables Sentry source-map upload during EAS builds. Without it the build still
# succeeds (runtime crash capture is unaffected). Pair with SENTRY_ORG/PROJECT.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
