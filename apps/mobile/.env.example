# Copy to .env and fill from your Supabase project (the SAME project as web).
# Only EXPO_PUBLIC_* variables are exposed to the client bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the /api/v1 REST surface lives.
# Local dev: http://localhost:3000 works for the iOS simulator and web.
# A physical device must use your machine's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
