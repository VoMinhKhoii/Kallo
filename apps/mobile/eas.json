{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "FILL_ME_PRODUCTION_CLOUD_RUN_URL"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "FILL_ME_PRODUCTION_CLOUD_RUN_URL"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "FILL_ME_APPLE_ID_EMAIL",
        "ascAppId": "FILL_ME_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "FILL_ME_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
