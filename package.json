{
  "name": "nham",
  "version": "1.20.0",
  "private": true,
  "scripts": {
    "setup:env": "node scripts/dev/link-worktree-env.mjs",
    "predev": "node scripts/dev/link-worktree-env.mjs",
    "dev": "next dev",
    "dev:mobile": "bash apps/mobile-flutter/tool/dev_mobile.sh",
    "build": "next build",
    "start": "next start",
    "check:structure": "node scripts/ci/check-structure/check-structure.mjs --strict",
    "eval:pipeline": "bun --conditions=react-server scripts/eval/run-eval.ts",
    "eval:smoke": "bun --conditions=react-server scripts/eval/run-eval.ts --tier smoke --concurrency 1",
    "eval:core": "bun --conditions=react-server scripts/eval/run-eval.ts --tier core --concurrency 2",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "dbr:reset": "supabase db reset --linked && bun --env-file=.env.local scripts/db/backfill_embeddings.ts && bun --env-file=.env.local scripts/data/food-cards/sync-cards.ts && bun --env-file=.env.local scripts/db/backfill_card_embeddings.ts",
    "dbr:reset:nobackfill": "supabase db reset --linked",
    "dbr:push": "supabase db push",
    "dbr:pull": "supabase db pull",
    "dbr:diff": "supabase db diff",
    "dbr:status": "supabase migration list --linked"
  },
